+// ARM DDI 0406C, LDRD/STRD: a doubleword-aligned access may use a single transfer.
+// At address 4 mod 8 these instructions perform two individually aligned word transfers.
+// Keep the ordinary 64-bit callback for other addresses, including alignment faults.
+constexpr size_t word_pair_fallback = 65;  // A separate callback-table key, not a transfer width.
+
+static u64 ReadWordPair(A32::UserCallbacks* memory, u32 address) {
+    if ((address & 7) != 4)
+        return memory->MemoryRead64(address);
+    const u32 first = memory->MemoryRead32(address);
+    const u32 second = memory->MemoryRead32(address + 4);
+    return static_cast<u64>(first) | (static_cast<u64>(second) << 32);
+}
+
+static void WriteWordPair(A32::UserCallbacks* memory, u32 address, u64 value) {
+    if ((address & 7) != 4) {
+        memory->MemoryWrite64(address, value);
+        return;
+    }
+    memory->MemoryWrite32(address, static_cast<u32>(value));
+    memory->MemoryWrite32(address + 4, static_cast<u32>(value >> 32));
+}
