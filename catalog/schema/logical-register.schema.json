    "id",
    "status",
    "behaviorId",
    "name",
    "namingBasis",
    "initial",
    "masks",
    "unknownBitPolicy",
    "sideEffects",
    "timing",
    "stateTransitions",
    "irq",
    "dma",
    "connections",
    "producerPcs",
    "consumerPcs",
    "evidence",
    "tests",
    "provenance",
    "fields",
    "unknowns",
    "nextValidation",
    "selector",
    "wordBits",
    "accessByProfile"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "behaviorId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "namingBasis": {
      "type": "string"
    },
    "initial": {
      "type": "object"
    },
    "masks": {
      "type": "object"
    },
    "unknownBitPolicy": {
      "type": "string"
    },
    "sideEffects": {
      "type": "object"
    },
    "timing": {
      "type": "string"
    },
    "stateTransitions": {
      "type": "string"
    },
    "irq": {
      "type": "string"
    },
    "dma": {
      "type": "string"
    },
    "connections": {
      "type": "array"
    },
    "producerPcs": {
      "type": "array"
    },
    "consumerPcs": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "id",
          "bitOffset",
          "bitWidth",
          "type",
          "signed",
          "unit",
          "enums",
          "access",
          "sideEffects",
          "definition",
          "initial",
          "provenance",
          "supportingEvidence",
          "refutingEvidence",
          "unknowns",
          "nextValidation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "bitOffset": {
            "type": "integer"
          },
          "bitWidth": {
            "type": "integer"
          },
          "type": {
            "type": "string"
          },
          "signed": {
            "type": "boolean"
          },
          "unit": {
            "type": "string"
          },
          "enums": {
            "type": "object"
          },
          "access": {
            "type": "string"
          },
          "sideEffects": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "initial": {
            "type": "object"
          },
          "provenance": {
            "type": "object"
          },
          "supportingEvidence": {
            "type": "array"
          },
          "refutingEvidence": {
            "type": "array"
          },
          "unknowns": {
            "type": "array"
          },
          "nextValidation": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array"
    },
    "nextValidation": {
      "type": "string"
    },
    "selector": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "wordBits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "accessByProfile": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": "object",
        "required": [
          "readable",
          "writable",
          "status",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "readable": {
            "type": "boolean"
          },
          "writable": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "DISABLED",
              "IMPLEMENTED_FUNCTIONAL_HYPOTHESIS",
              "EXPERIMENTAL_INPUT",
              "NOT_IMPLEMENTED"
            ]
          },
          "provenance": {
            "type": "object"
          }
        }
      }
    }
