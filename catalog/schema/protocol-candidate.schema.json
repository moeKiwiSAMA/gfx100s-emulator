{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "coordinateKind",
    "selectorBits",
    "wordBits",
    "unit",
    "byteOrder",
    "transportPort",
    "deviceOwner",
    "implementationStatus",
    "unknownPolicy",
    "applicability",
    "requests",
    "provenance",
    "unknowns",
    "nextValidation"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "coordinateKind": {
      "type": "string",
      "enum": [
        "PROTOCOL_SELECTOR"
      ]
    },
    "selectorBits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "wordBits": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "unit": {
      "type": "string",
      "enum": [
        "selector"
      ]
    },
    "byteOrder": {
      "type": "string",
      "enum": [
        "big",
        "little"
      ]
    },
    "transportPort": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
    },
    "deviceOwner": {
      "type": "string",
      "enum": [
        "UNKNOWN"
      ]
    },
    "implementationStatus": {
      "type": "string",
      "enum": [
        "NOT_IMPLEMENTED"
      ]
    },
    "unknownPolicy": {
      "type": "string",
      "enum": [
        "refuse"
      ]
    },
    "applicability": {
      "type": "object",
      "required": [
        "body",
        "firmware"
      ],
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
        },
        "firmware": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
        }
      }
    },
    "requests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "type": "object",
        "required": [
          "id",
          "selector",
          "wordBits",
          "name",
          "direction",
          "observationStatus",
          "implementationStatus",
          "initial",
          "masks",
          "behaviorId",
          "sideEffects",
          "fields",
          "provenance",
          "evidence",
          "unknowns",
          "nextValidation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
          },
          "selector": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "wordBits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "name": {
            "type": "string",
            "enum": [
              "UNKNOWN"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          },
          "observationStatus": {
            "type": "string",
            "enum": [
              "REQUEST_OBSERVED_PENDING",
              "STATIC_CANDIDATE"
            ]
          },
          "implementationStatus": {
            "type": "string",
            "enum": [
              "NOT_IMPLEMENTED"
            ]
          },
          "initial": {
            "type": "object",
            "required": [
              "value",
              "source"
            ],
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "null"
              },
              "source": {
                "type": "string",
                "enum": [
                  "UNKNOWN"
                ]
              }
            }
          },
          "masks": {
            "type": "object",
            "required": [
              "writable",
              "preserve",
              "unknown",
              "prohibited"
            ],
            "additionalProperties": false,
            "properties": {
              "writable": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0
              },
              "preserve": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0
              },
              "unknown": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967295
              },
              "prohibited": {
                "type": "integer",
                "minimum": 0,
                "maximum": 0
              }
            }
          },
          "behaviorId": {
            "type": "null"
          },
          "sideEffects": {
            "type": "string",
            "enum": [
              "UNKNOWN"
            ]
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "id",
                "bitOffset",
                "bitWidth",
                "type",
                "signed",
                "unit",
                "access",
                "provenance",
                "unknowns",
                "nextValidation"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "bitOffset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                },
                "bitWidth": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "raw-bits"
                  ]
                },
                "signed": {
                  "type": "boolean",
                  "enum": [
                    false
                  ]
                },
                "unit": {
                  "type": "string",
                  "enum": [
                    "UNKNOWN"
                  ]
                },
                "access": {
                  "type": "string",
                  "enum": [
                    "UNKNOWN"
                  ]
                },
                "provenance": {
                  "type": "object"
                },
                "unknowns": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "string"
                  }
                },
                "nextValidation": {
                  "type": "string"
                }
              }
            }
          },
          "provenance": {
            "type": "object"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "unknowns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string"
            }
          },
          "nextValidation": {
            "type": "string"
          }
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string"
      }
    },
    "nextValidation": {
      "type": "string"
    }
  }
}
